# --- Option A (recommended on Vercel): full connection string -----------------
# Supabase dashboard -> Connect -> "Transaction pooler" (port 6543).
# Vercel functions are IPv4-only, and the direct db.<ref>.supabase.co host is IPv6-only,
# so the pooler string is the one that works there.
# DATABASE_URL=postgresql://postgres.pinryxqaeltjwiipkrdb:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Option B: just the password ----------------------------------------------
# The app builds the connection string itself. Add SUPABASE_POOLER_HOST to go
# through the pooler (needed on Vercel); without it the direct host is used.
# SUPABASE_DB_PASSWORD=
# SUPABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com

# Optional: protects /api/keepalive. Vercel Cron sends it automatically when set.
# CRON_SECRET=

# With none of the database variables set, `npm run dev` uses a local embedded
# Postgres (PGlite) stored in ./.pglite, so the app runs with no setup.
